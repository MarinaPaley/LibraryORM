classDiagram
    class Entity~T~ {
        +Guid Id
    }
    class ValueObject {
        +Equals()
    }

    class Person {
        +string Name
        +string? Email
        +string? Phone
    }

    class Author {
        +string? Pseudonym
    }
    class Translator {
        +string? Language
    }
    class Editor {
        +string? Role
    }

    class Book {
        +int Year
        +string? Isbn
    }
    class Manuscript {
        +string Title
    }
    class Item {
        +string Condition
    }

    class Room {
        +string Name
    }
    class Cabinet {
        +string Label
    }
    class Shelf {
        +int Number
    }

    class Publisher {
        +string Name
    }
    class Genre {
        +string Name
    }

    class City {
        +string Name
    }
    class Street {
        +string Name
    }
    class Address {
        +string House
        +string? Building
        +string? Apartment
    }

    class Dimensions {
        +decimal Height
        +decimal Width
        +decimal Thickness
        +string Unit
    }

    Entity <|-- Person
